# Configuración del envío de códigos de verificación con Gmail.
# EMAIL_PASS debe ser una contraseña de aplicación de Google, no la contraseña normal.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu-cuenta@gmail.com
EMAIL_PASS=tu-contraseña-de-aplicacion
EMAIL_FROM=correo-remitente-verificado@example.com
